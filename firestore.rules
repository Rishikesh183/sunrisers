rules_version = '2';

// Firestore rules for use WITH Firebase Auth (request.auth is populated; user uids are the old
// Clerk ids, imported unchanged). Publish in the Firebase console -> Firestore -> Rules, or with
// the Firebase CLI. Do this only AFTER signing in with Firebase Auth works on the deployed site -
// until then keep the previous open rules or signed-out visitors / not-yet-migrated sessions break.
//
// Server-side scripts (firebase-admin) bypass these rules entirely.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Public profile: username, display name, photo. Readable by signed-in players (opponent
    // search, dashboard names); writable only by its owner.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // Username reservations: doc id = lower-cased username. Public read so the sign-up form can
    // check availability before an account exists.
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && name == request.resource.data.username.lower();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 1v1 duels: only the host, the invited opponent and the joined guest can change a room.
    match /duelRooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in [
        resource.data.hostUid, resource.data.guestUid, resource.data.opponentUid
      ];
      // The room is deleted by a player once both have seen the result (markResultSeen).
      allow delete: if signedIn() && request.auth.uid in [
        resource.data.hostUid, resource.data.guestUid, resource.data.opponentUid
      ];

      match /picks/{turn} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.auth.uid in [
            get(/databases/$(database)/documents/duelRooms/$(roomId)).data.hostUid,
            get(/databases/$(database)/documents/duelRooms/$(roomId)).data.guestUid
          ];
        // The 22 picks are deleted by a player in the same transaction that finalises the duel.
        allow delete: if signedIn()
          && request.auth.uid in [
            get(/databases/$(database)/documents/duelRooms/$(roomId)).data.hostUid,
            get(/databases/$(database)/documents/duelRooms/$(roomId)).data.guestUid
          ];
      }
    }

    // Finished duels: each player can read their own history; written once, never edited.
    match /duelResults/{id} {
      // winnerUid == you lets the dashboard count your wins without downloading the games.
      allow read: if signedIn() && (request.auth.uid in resource.data.participants || resource.data.winnerUid == request.auth.uid);
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
    }

    // 300 Par leaderboard: public to read; a player can only write their own row, only with a
    // 300-800 score, and can only raise their count of 300s by one at a time.
    match /leaderboard/{difficulty}/entries/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.bestScore >= 300 && request.resource.data.bestScore <= 800
        && request.resource.data.count300 == 1;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.bestScore >= resource.data.bestScore
        && request.resource.data.bestScore <= 800
        && request.resource.data.count300 == resource.data.count300 + 1;
    }
    match /leaderboardDaily/{key}/entries/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.bestScore >= 300 && request.resource.data.bestScore <= 800
        && request.resource.data.count300 == 1;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.bestScore >= resource.data.bestScore
        && request.resource.data.bestScore <= 800
        && request.resource.data.count300 == resource.data.count300 + 1;
    }

    // Site content, read during server rendering without a signed-in user.
    match /matches/{id} {
      allow read: if true;
    }
    // /api/news adds news from the server with the client SDK (no user), so writes stay open.
    // Tighten this when that route moves to firebase-admin.
    match /news/{id} {
      allow read, write: if true;
    }
  }
}
