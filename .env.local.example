# Firebase client config (Project Settings -> General -> Your apps). Used by the browser for
# Firestore and Firebase Authentication. Must be set locally AND on Vercel.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server-only - from a service account key, Project Settings -> Service
# Accounts -> Generate new private key). Only the scripts in scripts/ use these (backup, import,
# cleanup) - the deployed app does not, so they don't need to be on Vercel. Never prefix these
# with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Clerk is no longer used by the app (sign-in is Firebase Auth). This key is only read by
# scripts/backup-data.mjs and scripts/import-clerk-users.mjs for the one-time migration - delete
# it once you no longer need to re-run those.
CLERK_SECRET_KEY=

# Duel grounds (beta): true = hosts can pick a stadium (Hyderabad / Mumbai / Chennai / Bengaluru) and the
# match is simulated on it; false (or unset) = feature closed, standard duel logic, no picker.
# NEXT_PUBLIC_* values are baked in at build time - after changing it on Vercel, redeploy.
NEXT_PUBLIC_STADIUMS_ENABLED=false

# Admin allow-list for /api/news and /addNews: comma-separated Firebase uids (Authentication -> Users -> User UID).
# Unset = nobody can add news. Needs the Firebase Admin vars above to be set on Vercel too.
ADMIN_UIDS=

# Firebase App Check (reCAPTCHA v3 site key). Optional but recommended: create the key at
# https://www.google.com/recaptcha/admin, register it under Firebase console -> App Check, then switch
# enforcement ON for Cloud Firestore and Authentication. Blocks scripts that bypass the website.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
